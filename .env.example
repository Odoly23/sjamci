# Kopia ficheiru ne'e ba ".env" no prenxe valór. LABELE komete ".env" ba Git.

# ── Obrigatóriu ───────────────────────────────────────────────
# Jera ho: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=sjamci.mci.gov.tl

# ── Baze-dadus (se mamuk: SQLite, só ba dezenvolvimentu) ──────
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ── Seguransa ────────────────────────────────────────────────
# URL painel admin (troka ba valór segredu rasik, remata ho "/")
ADMIN_URL=
# HTTPS obrigatóriu bainhira DEBUG=False. Só define False se seidauk iha sertifikadu TLS.
HTTPS_ONLY=True
CSRF_TRUSTED_ORIGINS=https://sjamci.mci.gov.tl
CORS_ALLOWED_ORIGINS=
LOGIN_FAILURE_LIMIT=5
LOGIN_COOLOFF_HOURS=0.25
PASSWORD_MIN_LENGTH=10

# ── Email (reset password no alerta erru) ─────────────────────
EMAIL_USER=
EMAIL_PASS=
DEFAULT_FROM_EMAIL=Sistema MCI <info@mci.gov.tl>
ADMIN_EMAIL=

# ── Mapa ─────────────────────────────────────────────────────
MAPBOX_TOKEN=
MAPBOX_TOKENS=
google_key=

# ── Pajina públiku (landing) ─────────────────────────────────
LANDING_PHONE=+670 0000 0000
LANDING_EMAIL=info@mci.gov.tl
LANDING_ADDRESS=Dili, Timor-Leste
